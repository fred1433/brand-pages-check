{
  "name": "brand-pages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "check:pages": "node scripts/check-pages.mjs",
    "build": "pnpm -r --filter './apps/*' build",
    "build:brand": "node scripts/build-brand.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "check:separation": "node scripts/fingerprint.mjs --verify",
    "check": "node scripts/check-all.mjs",
    "check:fast": "node scripts/check-pages.mjs && node --test tests/unit/"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "yaml": "2.9.1"
  }
}
