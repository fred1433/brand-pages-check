{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check:pages)",
      "Bash(pnpm -s check:pages)",
      "Bash(pnpm check:fast)",
      "Bash(pnpm -s check:fast)",
      "Bash(node scripts/check-pages.mjs)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git pull *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(gh run view *)",
      "Edit(apps/*/content/pages/**)",
      "Write(apps/*/content/pages/**)"
    ],
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(apps/*/src/**)",
      "Write(apps/*/src/**)",
      "Edit(apps/*/public/**)",
      "Write(apps/*/public/**)",
      "Edit(apps/*/astro.config.mjs)",
      "Write(apps/*/astro.config.mjs)",
      "Edit(apps/*/package.json)",
      "Write(apps/*/package.json)",
      "Edit(brands/**)",
      "Write(brands/**)",
      "Edit(packages/**)",
      "Write(packages/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(tests/**)",
      "Write(tests/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Edit(pnpm-workspace.yaml)",
      "Write(pnpm-workspace.yaml)",
      "Edit(playwright.config.mjs)",
      "Write(playwright.config.mjs)",
      "Edit(.gitignore)",
      "Write(.gitignore)",
      "Edit(.npmrc)",
      "Write(.npmrc)",
      "Read(~/Library/Application Support/com.vercel.cli/**)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(pnpm dlx vercel *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push origin main*)",
      "Bash(git push * --force*)",
      "Bash(git commit * --no-verify*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/Library/Application Support/com.vercel.cli"
      ],
      "denyWrite": [
        ".claude",
        ".github",
        "apps/vertical-printers/src",
        "apps/brand-b/src",
        "apps/vertical-printers/public",
        "apps/brand-b/public",
        "apps/vertical-printers/astro.config.mjs",
        "apps/brand-b/astro.config.mjs",
        "apps/vertical-printers/package.json",
        "apps/brand-b/package.json",
        "brands",
        "packages",
        "scripts",
        "tests",
        "CLAUDE.md",
        "README.md",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "playwright.config.mjs",
        ".gitignore",
        ".npmrc"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org"
      ]
    },
    "failIfUnavailable": true,
    "enableWeakerNetworkIsolation": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-publish.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
