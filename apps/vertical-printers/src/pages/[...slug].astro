---
import YAML from 'yaml';
import Layout from '@brands/vertical-printers/sections/Layout.astro';
import { registry } from '@brands/vertical-printers/sections/registry';

export function getStaticPaths() {
  const files = import.meta.glob('../../content/pages/*.yaml', { query: '?raw', import: 'default', eager: true });
  return Object.entries(files).map(([file, raw]) => {
    const slug = file.split('/').pop().replace(/\.yaml$/, '');
    return { params: { slug: slug === 'index' ? undefined : slug }, props: { page: YAML.parse(raw) } };
  });
}
const { page } = Astro.props;
const deployEnv = import.meta.env.PUBLIC_DEPLOY_ENV ?? 'preview';
---
<Layout page={page} deployEnv={deployEnv}>
  {page.sections.map((s) => {
    const Section = registry[s.type];
    return <Section {...s} />;
  })}
</Layout>
