---
import TrackingHead from '@shared/tracking/TrackingHead.astro';
import ConsentBanner from '@shared/tracking/ConsentBanner.astro';
import brand from '../brand.config.json';
const { page, deployEnv } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <TrackingHead brand={brand} deployEnv={deployEnv} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="icon" href="data:," />
    <style is:global>
      body { font-family: Georgia, serif; margin: 0; color: #1d2b36; background: #eef3f6; }
      main { max-width: 640px; margin: 0 auto; padding: 48px 20px; }
      input, button { font: inherit; padding: 10px 14px; }
      [data-consent-banner][hidden] { display: none; }
      [data-consent-banner] { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 16px; }
    </style>
  </head>
  <body>
    <p style="text-align:center;font-size:13px">{brand.demoNotice}</p>
    <main><slot /></main>
    <ConsentBanner />
    <script>
      import { enhanceLeadForms } from '@shared/forms/client';
      enhanceLeadForms();
    </script>
  </body>
</html>
