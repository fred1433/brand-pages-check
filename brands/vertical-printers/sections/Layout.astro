---
import '../brand.css';
import TrackingHead from '@shared/tracking/TrackingHead.astro';
import ConsentBanner from '@shared/tracking/ConsentBanner.astro';
import brand from '../brand.config.json';
import { logo } from './assets';
const { page, deployEnv } = Astro.props;
const firstForm = page.sections.find((s) => s.type === 'lead-form');
---
<!doctype html>
<html lang="en">
  <head>
    <TrackingHead brand={brand} deployEnv={deployEnv} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="icon" href="data:," />
  </head>
  <body class="font-sans antialiased">
    <p class="bg-ink px-4 py-2 text-center font-sans text-[13px] text-white/80">{brand.demoNotice}</p>
    <header class="px-4 sm:px-10">
      <div class="mx-auto flex max-w-[1280px] items-center justify-between py-5">
        <a href="/" aria-label="Vertical Printers home"><img src={logo} alt="Vertical Printers" class="h-[15px] w-auto sm:h-[18px]" /></a>
        {firstForm && (
          <a href={`#${firstForm.id}`} class="rounded-full bg-ink px-5 py-2.5 font-sans text-[14px] font-medium text-white hover:bg-panel">{firstForm.button}</a>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="px-4 pb-10 pt-6 sm:px-10">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-2 border-t border-line pt-6 font-sans text-[13px] text-mute sm:flex-row sm:justify-between">
        <span>Texts and photos: verticalprinters.com</span>
        <span>Demonstration copy built by The AI Pipe</span>
      </div>
    </footer>
    <ConsentBanner />
    <style is:global>
      [data-consent-banner] { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; max-width: 560px; margin-left: auto; background: #fff; color: #242424; border-radius: 18px; padding: 20px 22px; box-shadow: 0 0 0 1px #ccc; font-family: var(--font-sans); display: flex; flex-direction: column; gap: 14px; }
      [data-consent-banner][hidden] { display: none; }
      [data-consent-text] { font-size: 15px; line-height: 1.5; }
      [data-consent-actions] { display: flex; gap: 10px; }
      [data-consent-actions] button { border-radius: 999px; padding: 10px 18px; font-size: 14px; font-weight: 500; border: 1px solid #000; }
      [data-consent="granted"] { background: #000; color: #fff; }
      [data-consent="denied"] { background: #fff; color: #000; }
    </style>
    <script>
      import { enhanceLeadForms } from '@shared/forms/client';
      enhanceLeadForms();
    </script>
  </body>
</html>
