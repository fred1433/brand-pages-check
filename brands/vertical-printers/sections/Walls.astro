---
import { asset } from './assets';
const { headline, images } = Astro.props;
const imgs = images.map(asset);
---
<section class="bg-panel px-4 py-20 text-white sm:px-10 sm:py-24">
  <div class="mx-auto max-w-[1280px]">
    <h2 class="vp-title text-[36px] sm:text-[52px]">{headline}</h2>
    <div class={`mt-10 grid gap-3 sm:gap-4 ${imgs.length === 4 ? 'grid-cols-2 lg:grid-cols-4' : imgs.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
      {imgs.map((i) => (
        <figure class="overflow-hidden rounded-[14px] bg-black">
          <img src={i.src} alt={i.alt} loading="lazy" class="aspect-[3/4] h-full w-full object-cover" />
        </figure>
      ))}
    </div>
  </div>
</section>
