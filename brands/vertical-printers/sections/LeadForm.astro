---
import Button from './Button.astro';
const { id, form, headline, text, button, success } = Astro.props;
---
<section id={id} class="scroll-mt-6 px-4 py-20 sm:px-10 sm:py-24">
  <div class="mx-auto grid max-w-[1280px] gap-10 rounded-[18px] bg-panel px-6 py-12 text-white sm:px-14 sm:py-16 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <h2 class="vp-title max-w-[16ch] text-[36px] sm:text-[52px]">{headline}</h2>
      {text && <p class="vp-book mt-5 max-w-[44ch] text-[18px] leading-relaxed text-white/75">{text}</p>}
    </div>
    <form data-lead-form data-form-key={form} data-success={success} class="flex flex-col gap-4 self-end">
      <label class="font-sans text-[14px] text-white/70">First name
        <input name="firstName" autocomplete="given-name" required class="mt-2 block w-full rounded-full border border-white/25 bg-transparent px-5 py-3.5 text-[16px] text-white placeholder-white/40 outline-none focus:border-white" />
      </label>
      <label class="font-sans text-[14px] text-white/70">Email
        <input name="email" type="email" autocomplete="email" required class="mt-2 block w-full rounded-full border border-white/25 bg-transparent px-5 py-3.5 text-[16px] text-white outline-none focus:border-white" />
      </label>
      <div class="mt-3"><Button type="submit" label={button} /></div>
      <p data-lead-status role="status" class="min-h-[1.5em] font-sans text-[15px] text-white/85"></p>
      <p class="font-sans text-[13px] leading-snug text-white/60">Demonstration form: entries go to a demo list, not to Vertical Printers.</p>
    </form>
  </div>
</section>
